@model IEnumerable<Triowave.Models.CustomModels.GlobalQuote>

<style>
    /* Scoped to this partial's table only */
    .market-data-scroll {
        max-height: 480px;
        overflow-y: auto;
    }

        .market-data-scroll thead th {
            position: sticky;
            top: 0;
            z-index: 1;
        }
</style>

<div class="table-responsive market-data-scroll">

    <table class="table table-striped table-hover table-bordered mb-0">

        <thead class="table-light">

            <tr>
                <th>Date</th>
                <th>Open</th>
                <th>High</th>
                <th>Low</th>
                <th>Price</th>
                <th>Volume</th>
            </tr>

        </thead>

        <tbody>

            @foreach (var quote in Model)
            {
                <tr>

                    <td>
                        @quote.Date.ToString("yyyy-MM-dd")
                    </td>

                    <td>
                        @quote.Open
                    </td>

                    <td>
                        @quote.High
                    </td>

                    <td>
                        @quote.Low
                    </td>

                    <td>
                        @quote.Price
                    </td>

                    <td>
                        @quote.Volume
                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>
